# Masolja at .env.local neven, es toltse ki. A .env.local soha nem kerul a repoba.
# A beepitett szegedi minta kulcs nelkul is mukodik (elore feldolgozott eredmenyt jatszik vissza).
# Sajat fajl elo feldolgozasahoz Anthropic kulcs kell:
ANTHROPIC_API_KEY=
# Nem kotelezo: a ket modell felulirasa
# CLAUDE_FAST_MODEL=claude-haiku-5-5
# CLAUDE_STRONG_MODEL=claude-sonnet-5-5
# Regi szolgaltato; csak akkor hasznalja a program, ha nincs ANTHROPIC_API_KEY:
GEMINI_API_KEY=
